{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:roomplan-dxf:schema:report-v1",
  "title": "roomplan-dxf report-v1 — computed result",
  "description": "Computed quantities report produced by scripts/lib/quantities.js buildReport. Contract: SPEC.md section 3 (report-v1), section 4 (provenance). One kernel, many outputs: DXF, CSV, Markdown and apps consume this document and never re-derive geometry. Self-contained: every $ref points inside this document, no network reference.",
  "type": "object",
  "required": ["schemaVersion", "source", "totals", "elements"],
  "additionalProperties": true,
  "properties": {
    "schemaVersion": {
      "enum": ["roomplan.report/1", "report1"],
      "description": "SPEC section 3 mandates 'roomplan.report/1'. The current kernel still emits the legacy token 'report1'; both are accepted so that the schema describes what the engine actually produces today without any change to the calculations (REPORT.md contradiction C-1)."
    },
    "engine": { "type": "string" },
    "source": {
      "type": "object",
      "additionalProperties": true,
      "description": "SPEC: source{sha256, dialect, captureSchema}. The engine knows sha256/byteCount/kind and does not stamp the capture schema it did not read.",
      "properties": {
        "sha256": { "type": ["string", "null"], "pattern": "^[0-9a-fA-F]{0,64}$" },
        "byteCount": { "type": ["integer", "null"], "minimum": 0 },
        "kind": { "enum": ["raw", "optimized", null] },
        "dialect": { "type": ["string", "null"] },
        "captureSchema": { "const": "roomplan.capture/1", "description": "Present once the kernel records the capture contract it consumed." }
      }
    },
    "totals": {
      "type": "object",
      "additionalProperties": true,
      "description": "SPEC: totals{floorArea, ceilingArea, wallAreaGross, wallAreaNet, openingArea, wallLength, paintArea, livingArea?, roomCount, wallCount, doorCount, windowCount, objectCount, roomsWithoutArea}. Every numeric field is a measure (value/status/coverage/reason). The engine names the areas with an M2 suffix and does not yet report wallLength, paintArea, livingArea or roomsWithoutArea (REPORT.md C-1).",
      "required": ["floorAreaM2", "wallGrossAreaM2", "wallNetAreaM2", "ceilingAreaM2", "counts"],
      "properties": {
        "floorArea": { "$ref": "#/$defs/measure", "description": "SPEC name for floorAreaM2." },
        "floorAreaM2": { "$ref": "#/$defs/measure" },
        "ceilingArea": { "$ref": "#/$defs/measure", "description": "SPEC name for ceilingAreaM2." },
        "ceilingAreaM2": { "$ref": "#/$defs/measure" },
        "wallAreaGross": { "$ref": "#/$defs/measure", "description": "SPEC name for wallGrossAreaM2." },
        "wallGrossAreaM2": { "$ref": "#/$defs/measure" },
        "wallAreaNet": { "$ref": "#/$defs/measure", "description": "SPEC name for wallNetAreaM2." },
        "wallNetAreaM2": { "$ref": "#/$defs/measure" },
        "openingArea": { "$ref": "#/$defs/measure", "description": "SPEC name; engine splits it into doorAreaM2/windowAreaM2/openingAreaM2." },
        "openingAreaM2": { "$ref": "#/$defs/measure" },
        "doorAreaM2": { "$ref": "#/$defs/measure" },
        "windowAreaM2": { "$ref": "#/$defs/measure" },
        "wallLength": { "$ref": "#/$defs/measure", "description": "SPEC total; not computed by the current kernel." },
        "paintArea": { "$ref": "#/$defs/measure", "description": "SPEC total (free-opening threshold); not computed by the current kernel." },
        "livingArea": { "$ref": "#/$defs/measure", "description": "SPEC optional total (ArchiPlan planStatistics); not computed by the current kernel." },
        "roomCount": { "type": "integer", "minimum": 0 },
        "wallCount": { "type": "integer", "minimum": 0 },
        "doorCount": { "type": "integer", "minimum": 0 },
        "windowCount": { "type": "integer", "minimum": 0 },
        "objectCount": { "type": "integer", "minimum": 0 },
        "roomsWithoutArea": { "type": ["integer", "array"], "description": "SPEC: count (or list) of rooms with no floor area." },
        "counts": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 },
          "description": "Engine element census per kind; supplies roomCount/wallCount/... in one place."
        },
        "uniqueElementCount": { "type": "integer", "minimum": 0 },
        "unlinkedOpeningKeys": { "type": "array", "items": { "type": "string" } },
        "volumeM3": { "$ref": "#/$defs/measure" }
      }
    },
    "stories": {
      "type": "array",
      "description": "SPEC: stories[{story, label, totals, rooms[{id, label, floorArea, ceilingArea, ceilingMethod, wallAreaNetBoundary, wallRun, boundaryDoorCount, boundaryWindowCount}]}]. The engine's stories[].rooms is a list of room identifiers, and the per-room details live in the top-level 'rooms' (REPORT.md C-1).",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["story"],
        "properties": {
          "story": { "type": "integer" },
          "label": { "type": ["string", "null"] },
          "totals": { "type": "object", "additionalProperties": true },
          "rooms": {
            "type": "array",
            "items": {
              "oneOf": [
                { "type": "string" },
                { "$ref": "#/$defs/storyRoom" }
              ]
            }
          }
        }
      }
    },
    "rooms": {
      "type": "array",
      "description": "Engine per-room detail (the SPEC per-story room fields, flattened per story).",
      "items": { "$ref": "#/$defs/room" }
    },
    "elements": {
      "type": "array",
      "items": { "$ref": "#/$defs/element" }
    },
    "warnings": {
      "type": "array",
      "description": "SPEC: warnings[{code, message, severity}]. The engine emits code plus case-specific detail fields and omits message/severity (REPORT.md C-1).",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["code"],
        "properties": {
          "code": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
          "message": { "type": "string" },
          "severity": { "enum": ["info", "warning", "error"] },
          "roomIdentifier": { "type": ["string", "integer", "null"] },
          "differenceM2": { "type": "number" },
          "reason": { "type": "string" }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": { "type": "string" },
      "description": "SPEC: assumptions[string]. Not emitted by the current kernel; conventions.caveat carries the same information today."
    },
    "conventions": { "type": "object", "additionalProperties": true },
    "sourceReferences": { "type": "object", "additionalProperties": true },
    "summary": { "type": "object", "additionalProperties": true }
  },
  "$defs": {
    "provenanceStatus": {
      "description": "SPEC section 4 provenance vocabulary.",
      "enum": ["supplied", "computed", "reconstructed", "estimated", "unavailable"]
    },
    "coverage": {
      "description": "SPEC section 4: complete | partial. NOTE the engine uses the same two words as *status* for subtotals and uses 'coverage' for the geometry class (computed/estimated/source-derived). Both vocabularies are accepted, see REPORT.md C-1.",
      "enum": ["supplied", "complete", "partial", "computed", "estimated", "unavailable", "source-derived", "inferred"]
    },
    "status": {
      "description": "Provenance status, plus the engine's subtotal words complete/partial.",
      "enum": ["supplied", "computed", "reconstructed", "estimated", "unavailable", "complete", "partial"]
    },
    "ceilingMethod": {
      "description": "SPEC section 3: supplied | knee | section | extrusion | flat | unavailable. 'explicit' is the engine's word for a supplied ceiling polygon (REPORT.md C-1).",
      "enum": ["supplied", "knee", "section", "extrusion", "flat", "explicit", "unavailable", null]
    },
    "measure": {
      "type": "object",
      "additionalProperties": true,
      "description": "SPEC section 4: every numeric field appears as {value, status, coverage, reason}; unknown is never zero.",
      "required": ["value", "coverage"],
      "properties": {
        "value": { "type": ["number", "null"] },
        "status": { "$ref": "#/$defs/status" },
        "coverage": { "$ref": "#/$defs/coverage" },
        "reason": { "type": ["string", "null"] },
        "included": { "type": "integer", "minimum": 0 },
        "expected": { "type": "integer", "minimum": 0 },
        "reasons": { "type": "array", "items": { "type": "string" } },
        "byStatus": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "basis": { "type": "string" },
        "method": { "$ref": "#/$defs/ceilingMethod" },
        "heightM": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "min": { "type": "number" },
                "max": { "type": "number" }
              }
            }
          ]
        }
      }
    },
    "slopeCut": {
      "type": "object",
      "additionalProperties": true,
      "description": "SPEC G-2: the triangle the roof takes out of the wall face, never silently applied.",
      "required": ["status"],
      "properties": {
        "status": { "enum": ["computed", "estimated", "unavailable", null] },
        "cutArea": { "type": ["number", "null"] },
        "triangles": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "dW": { "type": "number" },
              "dH": { "type": "number" },
              "area": { "type": "number" }
            }
          }
        },
        "ridgeHeight": { "type": ["number", "null"] },
        "kneeHeight": { "type": ["number", "null"] },
        "slopeCount": { "type": "integer", "minimum": 0 },
        "convex": { "type": "boolean" },
        "flatGrossArea": { "type": ["number", "null"] },
        "correctedGrossArea": { "type": ["number", "null"] },
        "note": { "type": "string" }
      }
    },
    "roomMembership": {
      "type": "object",
      "additionalProperties": true,
      "required": ["roomIdentifier"],
      "properties": {
        "roomIdentifier": { "type": ["string", "integer", "null"] },
        "coverage": { "$ref": "#/$defs/coverage" },
        "method": { "type": "string" }
      }
    },
    "element": {
      "type": "object",
      "additionalProperties": true,
      "description": "SPEC: elements[{id, kind, story, area, areaStatus, coverage, reason, roomRefs[], slopeCut?}]. The engine keys elements by 'key' and reports grossAreaM2/netAreaM2 instead of a single 'area'.",
      "required": ["key", "kind"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "id": { "type": ["string", "integer", "null"], "description": "SPEC name." },
        "identifier": { "type": ["string", "integer", "null"], "description": "Engine name for id." },
        "kind": { "enum": ["wall", "floor", "door", "window", "opening", "object"] },
        "story": { "type": ["integer", "null"] },
        "category": { "type": ["string", "null"] },
        "area": { "$ref": "#/$defs/measure", "description": "SPEC single area; engine keeps gross and net apart." },
        "areaStatus": { "$ref": "#/$defs/status" },
        "coverage": { "$ref": "#/$defs/coverage" },
        "reason": { "type": ["string", "null"] },
        "roomRefs": { "type": "array", "items": { "type": ["string", "integer", "null"] }, "description": "SPEC name." },
        "roomMemberships": { "type": "array", "items": { "$ref": "#/$defs/roomMembership" } },
        "grossAreaM2": { "$ref": "#/$defs/measure" },
        "netAreaM2": { "$ref": "#/$defs/measure" },
        "thicknessM": { "$ref": "#/$defs/measure" },
        "slopeCut": { "anyOf": [{ "$ref": "#/$defs/slopeCut" }, { "type": "null" }] },
        "parentIdentifier": { "type": ["string", "null"] },
        "parentLinkStatus": { "enum": ["linked", "ambiguous", "unlinked"] },
        "count": { "type": "integer", "minimum": 1 },
        "provenance": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "warnings": { "type": "array", "items": { "type": "string" } },
        "sourceStory": { "type": ["integer", "null"] },
        "storyProvenance": { "type": "string" },
        "openingKeys": { "type": "array", "items": { "type": "string" } },
        "openingDiagnostics": { "type": "array", "items": { "type": "object", "additionalProperties": true } }
      }
    },
    "storyRoom": {
      "type": "object",
      "additionalProperties": true,
      "description": "SPEC per-story room row.",
      "properties": {
        "id": { "type": ["string", "integer", "null"] },
        "label": { "type": ["string", "null"] },
        "floorArea": { "$ref": "#/$defs/measure" },
        "ceilingArea": { "$ref": "#/$defs/measure" },
        "ceilingMethod": { "$ref": "#/$defs/ceilingMethod" },
        "wallAreaNetBoundary": { "$ref": "#/$defs/measure" },
        "wallRun": { "$ref": "#/$defs/measure" },
        "boundaryDoorCount": { "type": "integer", "minimum": 0 },
        "boundaryWindowCount": { "type": "integer", "minimum": 0 }
      }
    },
    "room": {
      "type": "object",
      "additionalProperties": true,
      "description": "Per-room row of the engine report, plus the SPEC story-room names.",
      "required": ["identifier"],
      "properties": {
        "identifier": { "type": ["string", "integer", "null"] },
        "id": { "type": ["string", "integer", "null"], "description": "SPEC name." },
        "label": { "type": ["string", "null"] },
        "story": { "type": ["integer", "null"] },
        "sourceRoomIndex": { "type": ["integer", "null"] },
        "declaredAreaM2": { "$ref": "#/$defs/measure" },
        "polygonAreaM2": { "$ref": "#/$defs/measure" },
        "polygonMinusDeclaredM2": { "type": ["number", "null"] },
        "floorArea": { "$ref": "#/$defs/measure", "description": "SPEC name for polygonAreaM2." },
        "ceilingAreaM2": { "$ref": "#/$defs/measure" },
        "ceilingArea": { "$ref": "#/$defs/measure", "description": "SPEC name for ceilingAreaM2." },
        "wallAreaNetBoundary": { "$ref": "#/$defs/measure", "description": "SPEC per-story room field; engine reports roomSideWallGrossAreaM2." },
        "roomSideWallGrossAreaM2": { "$ref": "#/$defs/measure" },
        "wallRun": { "$ref": "#/$defs/measure" },
        "boundaryDoorCount": { "type": "integer", "minimum": 0 },
        "boundaryWindowCount": { "type": "integer", "minimum": 0 },
        "elementKeys": { "type": "array", "items": { "type": "string" } },
        "roomSideCounts": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "volumeM3": { "$ref": "#/$defs/measure" }
      }
    }
  }
}
