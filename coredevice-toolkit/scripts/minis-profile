#!/usr/bin/env python3
"""
minis-profile: 原生免跳转 Safari、免手动确认的 iOS 描述文件 (Configuration Profile) 管理器

基于 CoreDevice RSD 隧道 + com.apple.mobile.MCInstall.shim.remote 服务，
通过本地 pymobiledevice3 MobileConfigService 直接与设备 MCInstall 协议交互：

  minis-profile list                              列出已安装的描述文件
  minis-profile install <path.mobileconfig>       直接下发并安装描述文件
  minis-profile remove <profile_identifier>      静默移除指定描述文件

依赖：minis_device.MinisDeviceSession（RSD 安全隧道会话）
"""

import argparse
import asyncio
import os
import plistlib
import sys
from pathlib import Path

from minis_device import MinisDeviceSession
from pymobiledevice3.exceptions import ProfileError
from pymobiledevice3.services.mobile_config import MobileConfigService

KEYBAG_ENV = "MINIS_PROFILE_KEYBAG"
KEYBAG_GLOBS = [
    "/var/minis/mounts/*/[Ss]upervis*.pem",
    "/var/minis/mounts/*/[Ss]upervisor*.pem",
    "/var/minis/workspace/**/[Ss]upervis*.pem",
]


def resolve_keybag(explicit: str | None) -> Path | None:
    """定位监管身份 (supervision identity) PEM keybag，用于真正的静默安装。"""
    candidates = []
    if explicit:
        candidates.append(explicit)
    if os.environ.get(KEYBAG_ENV):
        candidates.append(os.environ[KEYBAG_ENV])
    for pattern in KEYBAG_GLOBS:
        import glob as _glob
        candidates.extend(sorted(_glob.glob(pattern, recursive=True)))
    for c in candidates:
        p = Path(c)
        if p.is_file():
            return p
    return None


def describe_payload(path: str) -> tuple[bytes, str]:
    """读取 .mobileconfig 原始字节，并尽力解析其显示名。"""
    p = Path(path)
    if not p.is_file():
        raise SystemExit(f"错误：找不到描述文件 {path}")
    data = p.read_bytes()
    if not data:
        raise SystemExit(f"错误：描述文件为空 {path}")
    name = p.name
    try:
        pl = plistlib.loads(data)
        if isinstance(pl, dict):
            name = pl.get("PayloadDisplayName") or pl.get("PayloadIdentifier") or name
    except Exception:
        # CMS/PKCS7 签名封装的描述文件，无法直接 plist 解析，按原样下发
        pass
    return data, name


async def cmd_list(args) -> int:
    print("⚡ 正在通过 CoreDevice RSD 隧道连接 com.apple.mobile.MCInstall.shim.remote ...")
    async with MinisDeviceSession() as s:
        mc = MobileConfigService(s.rsd)
        resp = await mc.get_profile_list()
        metadata = resp.get("ProfileMetadata") or {}
        if args.json:
            import json
            print(json.dumps(metadata, ensure_ascii=False, indent=2, default=str))
            return 0
        if not metadata:
            print("\n📭 设备上没有已安装的 Configuration Profile（0 个）")
            return 0
        rows = []
        for ident, meta in metadata.items():
            rows.append({
                "PayloadDisplayName": meta.get("PayloadDisplayName", ""),
                "PayloadIdentifier": meta.get("PayloadIdentifier", ident),
                "PayloadUUID": meta.get("PayloadUUID", ""),
                "PayloadVersion": meta.get("PayloadVersion", ""),
                "PayloadType": meta.get("PayloadType", ""),
            })
        print(f"\n📋 已安装描述文件（共 {len(rows)} 个）")
        print("=" * 78)
        for i, r in enumerate(rows, 1):
            print(f" {i}. {r['PayloadDisplayName'] or '(未命名)'}")
            print(f"    PayloadIdentifier : {r['PayloadIdentifier']}")
            print(f"    PayloadUUID       : {r['PayloadUUID']}")
            if args.verbose:
                print(f"    PayloadVersion    : {r['PayloadVersion']}")
                if r['PayloadType']:
                    print(f"    PayloadType       : {r['PayloadType']}")
        print("=" * 78)
    return 0


async def cmd_install(args) -> int:
    payload, display_name = describe_payload(args.path)
    keybag = resolve_keybag(args.keybag)
    print(f"⚡ 目标描述文件: {display_name} ({Path(args.path).name}, {len(payload)} bytes)")
    print("⚡ 正在通过 CoreDevice RSD 隧道连接 com.apple.mobile.MCInstall.shim.remote ...")
    async with MinisDeviceSession() as s:
        mc = MobileConfigService(s.rsd)
        mode = None
        if keybag:
            # 监管身份静默安装：Escalate -> InstallProfileSilent，设备端零交互
            print(f"🔑 检测到监管身份 keybag: {keybag}")
            await mc.install_profile_silent(keybag, payload)
            mode = "InstallProfileSilent（监管静默，设备零弹窗）"
        else:
            # 无监管身份时，先尝试协议层静默安装（设备允许时直接生效）
            try:
                await mc._send_recv({"RequestType": "InstallProfileSilent", "Payload": payload})
                mode = "InstallProfileSilent（协议层静默）"
            except ProfileError:
                await mc.install_profile(payload)
                mode = "InstallProfile（经 MCInstall 直接下发，免跳转 Safari；是否二次确认由设备策略决定）"
        # 安装后回读校验
        resp = await mc.get_profile_list()
        metadata = resp.get("ProfileMetadata") or {}
        installed = None
        try:
            ident = plistlib.loads(payload).get("PayloadIdentifier")
        except Exception:
            ident = None
        if ident and ident in metadata:
            installed = metadata[ident]
        print(f"\n✅ 安装完成，模式: {mode}")
        if installed:
            print(f"   PayloadDisplayName: {installed.get('PayloadDisplayName', '')}")
            print(f"   PayloadIdentifier : {installed.get('PayloadIdentifier', '')}")
            print(f"   PayloadUUID       : {installed.get('PayloadUUID', '')}")
        elif ident:
            print(f"   ⚠️ 已下发但回读列表暂未见 {ident}（可能等待设备侧生效）")
        print(f"   当前设备描述文件总数: {len(metadata)}")
    return 0


async def cmd_remove(args) -> int:
    identifier = args.identifier
    print("⚡ 正在通过 CoreDevice RSD 隧道连接 com.apple.mobile.MCInstall.shim.remote ...")
    async with MinisDeviceSession() as s:
        mc = MobileConfigService(s.rsd)
        resp = await mc.get_profile_list()
        metadata = resp.get("ProfileMetadata") or {}
        if identifier not in metadata:
            print(f"❌ 未找到标识为 {identifier} 的描述文件（当前共 {len(metadata)} 个）")
            return 2
        target = metadata[identifier]
        await mc.remove_profile(identifier)
        resp2 = await mc.get_profile_list()
        metadata2 = resp2.get("ProfileMetadata") or {}
        ok = identifier not in metadata2
        verb = "已移除" if ok else "已下发移除请求"
        print(f"\n✅ {verb}: {target.get('PayloadDisplayName', identifier)} ({identifier})")
        print(f"   当前设备描述文件总数: {len(metadata2)}")
        return 0 if ok else 0
    return 0


def build_parser() -> argparse.ArgumentParser:
    ap = argparse.ArgumentParser(
        prog="minis-profile",
        description="原生免跳转 Safari、免手动确认的 iOS 描述文件管理器（CoreDevice RSD + MCInstall.shim.remote）",
    )
    sub = ap.add_subparsers(dest="command", required=True)

    p_list = sub.add_parser("list", help="列出当前系统已安装的所有 Configuration Profiles")
    p_list.add_argument("--json", action="store_true", help="以 JSON 输出 ProfileMetadata")
    p_list.add_argument("-v", "--verbose", action="store_true", help="附加输出版本与类型")
    p_list.set_defaults(func=cmd_list)

    p_inst = sub.add_parser("install", help="免跳转 Safari、免确认静默安装描述文件")
    p_inst.add_argument("path", help=".mobileconfig 文件路径")
    p_inst.add_argument("--keybag", help=f"监管身份 PEM keybag 路径（默认读取 ${KEYBAG_ENV} 或自动搜索）")
    p_inst.set_defaults(func=cmd_install)

    p_rm = sub.add_parser("remove", help="静默移除指定的描述文件")
    p_rm.add_argument("identifier", help="PayloadIdentifier（可用 minis-profile list 查询）")
    p_rm.set_defaults(func=cmd_remove)
    return ap


def main() -> int:
    ap = build_parser()
    args = ap.parse_args()
    try:
        return asyncio.run(args.func(args))
    except KeyboardInterrupt:
        return 130
    except ProfileError as e:
        print(f"\n❌ MCInstall 协议错误: {e}", file=sys.stderr)
        return 1
    except Exception as e:
        print(f"\n❌ 执行失败: {type(e).__name__}: {e}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
