#!/usr/bin/env python3
"""
cdtk-install: iOS 极客侧载与安装中枢 (基于 CoreDevice RSD & installation_proxy)
支持应用查询 (list)、IPA 原生直装 (install)、一键干净卸载 (uninstall) 以及本地自签名集成
"""

import argparse
import asyncio
import os
import plistlib
import subprocess
import sys
import tempfile
import zipfile
from pathlib import Path

from coredevice_session import CoreDeviceSession
from pymobiledevice3.services.installation_proxy import InstallationProxyService

def find_signing_assets(cert_arg=None, prov_arg=None, pass_arg=None):
    """
    定位签名资产 (P12 证书、Provisioning Profile 与密码)。
    按优先级安全解析：
    1. 显式 CLI 参数 (--cert, --prov, --password)
    2. 环境变量 (CDTK_SIGN_CERT, CDTK_SIGN_PROV, CDTK_SIGN_PASS)
    3. 专用技能受控目录 /var/minis/workspace/cdtk/
    拒绝盲目全盘扫描，拒绝默认密码。
    """
    p12 = cert_arg or os.environ.get("CDTK_SIGN_CERT")
    prov = prov_arg or os.environ.get("CDTK_SIGN_PROV")
    pwd = pass_arg or os.environ.get("CDTK_SIGN_PASS")

    if not p12 or not prov:
        cdtk_dir = Path("/var/minis/workspace/cdtk")
        if cdtk_dir.is_dir():
            p12_files = list(cdtk_dir.glob("*.p12"))
            prov_files = list(cdtk_dir.glob("*.mobileprovision"))
            if p12_files and not p12:
                p12 = str(p12_files[0])
            if prov_files and not prov:
                prov = str(prov_files[0])
            if not pwd:
                pwd_files = list(cdtk_dir.glob("*pwd*.txt")) + list(cdtk_dir.glob("*pass*.txt"))
                if pwd_files:
                    try:
                        pwd = pwd_files[0].read_text(encoding="utf-8").strip()
                    except Exception:
                        pass

    if p12 and not Path(p12).is_file():
        raise FileNotFoundError(f"指定的 P12 证书文件不存在: {p12}")
    if prov and not Path(prov).is_file():
        raise FileNotFoundError(f"指定的描述文件不存在: {prov}")
    
    if p12 and prov:
        if pwd is None:
            raise ValueError(
                "检测到签名证书，但未提供证书密码！\n"
                "为防止密钥错误，CDTK 拒绝使用不可靠的默认密码。\n"
                "请通过 --password 参数或环境变量 export CDTK_SIGN_PASS=xxx 提供密码。"
            )
        print(f"🔑 使用签名资产: 证书={p12}, 描述文件={prov}")
        return p12, prov, pwd

    return None, None, None

def inspect_ipa(ipa_path):
    orig_bid = ""
    app_name = ""
    has_signature = False
    try:
        with zipfile.ZipFile(ipa_path, "r") as z:
            names = z.namelist()
            for n in names:
                if n.endswith("Info.plist") and n.count("/") == 2:
                    try:
                        pl = plistlib.loads(z.read(n))
                        orig_bid = pl.get("CFBundleIdentifier", "")
                        app_name = pl.get("CFBundleDisplayName") or pl.get("CFBundleName", "")
                    except Exception:
                        pass
                if "_CodeSignature" in n:
                    has_signature = True
    except Exception:
        pass
    return orig_bid, app_name, has_signature

def sign_ipa(src_ipa, dest_ipa, p12, prov, pwd, bundle_id=None, app_name=None):
    zsign_bin = "/usr/local/bin/zsign"
    if not os.path.exists(zsign_bin):
        which_z = subprocess.run(["which", "zsign"], stdout=subprocess.PIPE, text=True).stdout.strip()
        zsign_bin = which_z if which_z else "zsign"

    cmd = [
        zsign_bin,
        "-k", p12,
        "-p", pwd,
        "-m", prov,
        "-o", dest_ipa
    ]
    if bundle_id:
        cmd.extend(["-b", bundle_id])
    if app_name:
        cmd.extend(["-n", app_name])
    cmd.append(src_ipa)

    print(f"✍️  正在使用证书进行代码签名...")
    res = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
    if res.returncode != 0:
        err = res.stderr or res.stdout
        raise RuntimeError(f"zsign 签名失败: {err}")
    print(f"✅ 签名成功！生成合规安装包: {os.path.basename(dest_ipa)}")

async def cmd_list(args):
    async with CoreDeviceSession() as sess:
        installer = InstallationProxyService(sess.rsd)
        print(f"📱 设备就绪: iOS {sess.rsd.product_version} ({sess.rsd.product_build_version})")
        app_type = "User" if not args.all else "Any"
        apps = await installer.get_apps(application_type=app_type, calculate_sizes=False)
        
        filtered = {}
        for bid, meta in apps.items():
            name = meta.get("CFBundleDisplayName") or meta.get("CFBundleName", "")
            ver = meta.get("CFBundleShortVersionString", "")
            if args.filter:
                f = args.filter.lower()
                if f not in bid.lower() and f not in name.lower():
                    continue
            filtered[bid] = (name, ver)

        print(f"📦 共查询到 {len(filtered)} 个已安装应用:")
        print(f"{'应用名称':<25} {'版本':<14} {'Bundle Identifier'}")
        print("-" * 65)
        for bid, (name, ver) in sorted(filtered.items(), key=lambda x: x[1][0]):
            print(f"{name:<25} {ver:<14} {bid}")

async def cmd_install(args):
    # 强制二次确认阻断检查 (Reviewer Blocking 1)
    if not args.yes:
        print(f"🛑 [安全阻断] 准备向系统推送安装应用: {args.ipa}")
        print("   警告：安装应用可能覆盖已有应用沙盒数据或引入外部二进制！")
        print("   为确保安全，此高危操作必须显式追加 -y / --yes 参数方可执行。")
        sys.exit(1)

    ipa_path = os.path.abspath(args.ipa)
    if not os.path.exists(ipa_path):
        print(f"❌ 找不到安装包: {ipa_path}", file=sys.stderr)
        sys.exit(1)

    orig_bid, orig_name, has_sig = inspect_ipa(ipa_path)
    print(f"📦 目标安装包: {os.path.basename(ipa_path)} (原BundleID: {orig_bid or '未知'})")

    final_ipa = ipa_path
    tmp_signed = None

    need_sign = args.sign
    if not args.no_sign and not has_sig:
        need_sign = True

    if need_sign:
        p12, prov, pwd = find_signing_assets(args.cert, args.prov, args.password)
        if not p12 or not prov:
            print("❌ 错误：需要签名但未找到有效的 P12 证书与 Provision 描述文件！", file=sys.stderr)
            print("   请指定 --cert / --prov / --password 参数，或设置 CDTK_SIGN_* 环境变量。", file=sys.stderr)
            sys.exit(1)

        fd, tmp_signed = tempfile.mkstemp(suffix=".ipa", prefix="cdtk_signed_")
        os.close(fd)
        try:
            sign_ipa(
                ipa_path,
                tmp_signed,
                p12,
                prov,
                pwd,
                bundle_id=args.bundle_id,
                app_name=args.name
            )
            final_ipa = tmp_signed
        except Exception as e:
            if tmp_signed and os.path.exists(tmp_signed): os.unlink(tmp_signed)
            print(f"❌ 签名失败: {e}", file=sys.stderr)
            sys.exit(1)

    try:
        print(f"🚀 正在通过 CoreDevice RSD 隧道建立 installation_proxy 会话...")
        async with CoreDeviceSession() as sess:
            installer = InstallationProxyService(sess.rsd)
            print(f"⚡ 正在向系统发送安装指令 (Stream: {os.path.basename(final_ipa)})...")
            res = await installer.install(final_ipa)
            print(f"🎉 安装指令执行完成！返回状态: {res}")
            print(f"✨ 应用已成功部署至 iOS 系统桌面。")
    finally:
        if tmp_signed and os.path.exists(tmp_signed):
            try: os.unlink(tmp_signed)
            except Exception: pass

async def cmd_uninstall(args):
    # 强制二次确认阻断检查 (Reviewer Blocking 1)
    if not args.yes:
        print(f"🛑 [安全阻断] 准备从系统彻底卸载应用: {args.bundle_id}")
        print("   警告：卸载应用将彻底清除其沙盒内的全部本地数据且不可逆！")
        print("   为确保安全，此高危操作必须显式追加 -y / --yes 参数方可执行。")
        sys.exit(1)

    print(f"🗑️  准备卸载应用: {args.bundle_id}")
    async with CoreDeviceSession() as sess:
        installer = InstallationProxyService(sess.rsd)
        print(f"⚡ 正在向系统发送卸载请求...")
        await installer.uninstall(args.bundle_id)
        print(f"✅ 卸载完成！应用 {args.bundle_id} 及其沙盒容器已从设备移除。")

def main():
    parser = argparse.ArgumentParser(
        prog="cdtk-install",
        description="iOS 极客侧载与应用安装中枢 (CoreDevice RSD)"
    )
    subparsers = parser.add_subparsers(dest="cmd", required=True)

    # list
    p_list = subparsers.add_parser("list", help="枚举设备已安装的应用")
    p_list.add_argument("-f", "--filter", help="按应用名称或 BundleID 过滤")
    p_list.add_argument("-a", "--all", action="store_true", help="包含系统内置应用")

    # install
    p_install = subparsers.add_parser("install", help="向设备推送安装 IPA 文件")
    p_install.add_argument("ipa", help="IPA 文件本地路径")
    p_install.add_argument("-y", "--yes", action="store_true", help="确认执行安装（必需参数）")
    p_install.add_argument("-s", "--sign", action="store_true", help="显式要求使用本地证书签名")
    p_install.add_argument("--no-sign", action="store_true", help="禁止自动签名，直接推送原始包")
    p_install.add_argument("-b", "--bundle-id", help="自定义新 Bundle ID (分身/多开)")
    p_install.add_argument("-n", "--name", help="自定义应用桌面显示名称")
    p_install.add_argument("--cert", help="指定 P12 证书路径")
    p_install.add_argument("--prov", help="指定 mobileprovision 描述文件路径")
    p_install.add_argument("-p", "--password", help="指定证书密码")

    # uninstall
    p_un = subparsers.add_parser("uninstall", help="从设备卸载指定应用")
    p_un.add_argument("bundle_id", help="应用 Bundle Identifier (如 com.demo.app)")
    p_un.add_argument("-y", "--yes", action="store_true", help="确认执行卸载（必需参数）")

    args = parser.parse_args()
    if args.cmd == "list":
        asyncio.run(cmd_list(args))
    elif args.cmd == "install":
        asyncio.run(cmd_install(args))
    elif args.cmd == "uninstall":
        asyncio.run(cmd_uninstall(args))

if __name__ == "__main__":
    main()
