#!/usr/bin/env python3
"""
cdtk-ctrl: 基于 CoreDevice RSD 底层通道的 iOS 原生硬件级自动化控制中枢
免电脑、免越狱、零第三方 App 依赖，直接与 iOS 硬件输入总线 (dtuhidd) 与应用调度 (appservice) 交互
"""

import argparse
import asyncio
import json
import os
import sys
import time

from coredevice_session import CoreDeviceSession
from pymobiledevice3.remote.core_device.app_service import AppServiceService
from pymobiledevice3.remote.core_device.device_info import DeviceInfoService
from pymobiledevice3.remote.core_device.hid_service import (
    touch_session,
    UniversalHIDServiceService,
    TOUCHSCREEN_STATE_CONTACT,
    TOUCHSCREEN_STATE_RELEASE,
    DIGITIZER_SURFACE_MAIN_TOUCHSCREEN,
)

async def cmd_launch(args):
    print(f"⚡ 正在通过 CoreDevice RSD 拉起应用: {args.bundle_id}...")
    async with CoreDeviceSession() as s:
        async with AppServiceService(s.rsd) as app_svc:
            res = await app_svc.launch_application(
                args.bundle_id,
                kill_existing=not args.no_kill,
            )
            print(f"🎉 应用已成功启动！\n返回信息: {json.dumps(res, indent=2, ensure_ascii=False, default=str)}")

async def cmd_procs(args):
    print("⚡ 正在通过 CoreDevice RSD 查询系统进程列表...")
    async with CoreDeviceSession() as s:
        async with AppServiceService(s.rsd) as app_svc:
            procs = await app_svc.list_processes()
            print(f"\n📱 当前系统共运行 {len(procs)} 个进程:\n" + "-" * 65)
            print(f"{'PID':<8} {'类型':<10} {'应用 / 执行路径'}")
            print("-" * 65)
            count = 0
            for p in procs:
                pid = p.get("processIdentifier")
                url = p.get("executableURL", {}).get("relative", "")
                is_app = "/Applications/" in url or ".app/" in url
                if args.apps_only and not is_app:
                    continue
                if args.filter and args.filter.lower() not in url.lower():
                    continue
                
                app_tag = "📱 App" if is_app else "⚙️ Daemon"
                name = url.split("/")[-1]
                if ".app/" in url:
                    name = url.split(".app/")[0].split("/")[-1]
                print(f"{pid:<8} {app_tag:<10} {name} ({url})")
                count += 1
            print("-" * 65)
            print(f"共筛选出 {count} 个目标进程。")

async def cmd_hid_list(args):
    print("⚡ 正在通过 CoreDevice RSD 枚举底层硬件输入设备 (HID)...")
    async with CoreDeviceSession() as s:
        async with UniversalHIDServiceService(s.rsd) as hid:
            devices = await hid.list_connected_services()
            items = devices.get("connectedServices", []) if isinstance(devices, dict) else devices
            print(f"\n🎮 发现 {len(items)} 个底层硬件输入设备:\n" + "-" * 60)
            for dev in items:
                sid = dev.get("_ServiceID")
                prod = dev.get("Product")
                dtype = dev.get("DeviceTypeHint", "Generic")
                builtin = dev.get("UniversalControlBuiltIn", False)
                print(f"  • ServiceID: {sid:<6} 类型: {dtype:<12} 名称: {prod} {'[内置]' if builtin else ''}")
            print("-" * 60)

# HID 触控坐标与分辨率无关：(0, 0) 为左上角，(65535, 65535) 为右下角，方向为屏幕原生竖屏
HID_MAX = 65535

def screen_size(display_info):
    """主屏原生像素分辨率 (宽, 高)，与截图一致；像素 = 逻辑点 × pointScale"""
    primary = next(d for d in display_info["displays"] if d["primary"])
    w, h = primary["nativeSize"]
    return int(w), int(h)

def to_hid(x, y, size):
    """像素坐标 -> HID 坐标，取像素中心"""
    w, h = size
    if not (0 <= x < w and 0 <= y < h):
        raise ValueError(f"坐标 ({x}, {y}) 超出屏幕范围 {w}x{h}")
    return round((x + 0.5) * HID_MAX / w), round((y + 0.5) * HID_MAX / h)

async def resolve_points(rsd, args, points):
    """把命令行坐标统一转为 HID 坐标；带 --hid 时原样使用，只校验范围"""
    try:
        if args.hid:
            for x, y in points:
                if not (0 <= x <= HID_MAX and 0 <= y <= HID_MAX):
                    raise ValueError(f"HID 坐标 ({x}, {y}) 超出范围 0..{HID_MAX}")
            return points
        async with DeviceInfoService(rsd) as info:
            size = screen_size(await info.get_display_info())
        return [to_hid(x, y, size) for x, y in points]
    except ValueError as e:
        sys.exit(f"❌ {e}")

async def cmd_tap(args):
    print(f"⚡ 正在向物理屏幕注入真实硬件触控点击: ({args.x}, {args.y})...")
    async with CoreDeviceSession() as s:
        [(x, y)] = await resolve_points(s.rsd, args, [(args.x, args.y)])
        async with touch_session(s.rsd) as hid:
            tsid = args.service_id or DIGITIZER_SURFACE_MAIN_TOUCHSCREEN
            await hid.send_touchscreen(TOUCHSCREEN_STATE_CONTACT, x, y, service_id=tsid)
            await asyncio.sleep(0.06)
            await hid.send_touchscreen(TOUCHSCREEN_STATE_RELEASE, x, y, service_id=tsid)
            print(f"✅ 触控点击已注入完成！坐标: ({args.x}, {args.y})")

async def cmd_swipe(args):
    print(f"⚡ 正在向物理屏幕注入真实硬件滑动: ({args.x1}, {args.y1}) -> ({args.x2}, {args.y2})...")
    async with CoreDeviceSession() as s:
        (x1, y1), (x2, y2) = await resolve_points(s.rsd, args, [(args.x1, args.y1), (args.x2, args.y2)])
        async with touch_session(s.rsd) as hid:
            tsid = args.service_id or DIGITIZER_SURFACE_MAIN_TOUCHSCREEN
            steps = max(args.steps, 5)
            duration = max(args.duration, 0.05)
            interval = duration / steps
            
            for i in range(steps):
                t = i / steps
                cx = round(x1 + (x2 - x1) * t)
                cy = round(y1 + (y2 - y1) * t)
                await hid.send_touchscreen(TOUCHSCREEN_STATE_CONTACT, cx, cy, service_id=tsid)
                await asyncio.sleep(interval)
            
            await hid.send_touchscreen(TOUCHSCREEN_STATE_CONTACT, x2, y2, service_id=tsid)
            await hid.send_touchscreen(TOUCHSCREEN_STATE_RELEASE, x2, y2, service_id=tsid)
            print(f"✅ 硬件滑动已执行完成！耗时: {duration:.2f}s, 步数: {steps}")

def main():
    parser = argparse.ArgumentParser(description="cdtk-ctrl: iOS 原生硬件级自动化控制中枢")
    subparsers = parser.add_subparsers(dest="subcommand", required=True)

    # launch
    p_launch = subparsers.add_parser("launch", help="通过 CoreDevice 原生拉起任意 App")
    p_launch.add_argument("bundle_id", help="应用 Bundle Identifier (如 com.meituan.imeituan)")
    p_launch.add_argument("--no-kill", action="store_true", help="不强制杀死已有实例")

    # procs
    p_procs = subparsers.add_parser("procs", help="列出当前运行的 App 与进程")
    p_procs.add_argument("-f", "--filter", help="关键字过滤")
    p_procs.add_argument("--apps-only", action="store_true", default=True, help="仅列出带 UI 的 App 进程")
    p_procs.add_argument("--all", dest="apps_only", action="store_false", help="列出全部系统进程")

    # hid-list
    subparsers.add_parser("hid-list", help="列出底层硬件输入设备 (触摸屏/键盘/按键)")

    # tap
    p_tap = subparsers.add_parser("tap", help="向物理屏幕注入真实硬件触控点击")
    p_tap.add_argument("x", type=int, help="X 坐标 (像素，原生竖屏方向，与截图一致)")
    p_tap.add_argument("y", type=int, help="Y 坐标 (像素，原生竖屏方向，与截图一致)")
    p_tap.add_argument("--hid", action="store_true", help="坐标直接按 HID 归一化值 0..65535 解释，不做换算")
    p_tap.add_argument("--service-id", type=int, default=257, help="HID ServiceID (默认 257 物理触摸屏)")

    # swipe
    p_swipe = subparsers.add_parser("swipe", help="向物理屏幕注入真实硬件滑动")
    p_swipe.add_argument("x1", type=int, help="起点 X 坐标 (像素)")
    p_swipe.add_argument("y1", type=int, help="起点 Y 坐标 (像素)")
    p_swipe.add_argument("x2", type=int, help="终点 X 坐标 (像素)")
    p_swipe.add_argument("y2", type=int, help="终点 Y 坐标 (像素)")
    p_swipe.add_argument("-d", "--duration", type=float, default=0.25, help="滑动持续秒数 (默认 0.25s)")
    p_swipe.add_argument("-s", "--steps", type=int, default=15, help="插值步数 (默认 15)")
    p_swipe.add_argument("--service-id", type=int, default=257, help="HID ServiceID (默认 257)")
    p_swipe.add_argument("--hid", action="store_true", help="坐标直接按 HID 归一化值 0..65535 解释，不做换算")

    args = parser.parse_args()
    if args.subcommand == "launch": asyncio.run(cmd_launch(args))
    elif args.subcommand == "procs": asyncio.run(cmd_procs(args))
    elif args.subcommand == "hid-list": asyncio.run(cmd_hid_list(args))
    elif args.subcommand == "tap": asyncio.run(cmd_tap(args))
    elif args.subcommand == "swipe": asyncio.run(cmd_swipe(args))

if __name__ == "__main__":
    main()
